# App settings
APP_NAME="SQB Payment Reference Python App"
APP_ENV="dev"
APP_DEBUG=false

# SQB credential settings
SQB_BASE_URL="https://vsi-api.shouqianba.com"
SQB_VENDOR_SN="your_vendor_sn"
SQB_VENDOR_KEY="your_vendor_key"
SQB_CALLBACK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_SQB_PUBLIC_KEY\n-----END PUBLIC KEY-----"
SQB_TIMEOUT_SECONDS=10
SQB_USE_STUB_TRANSPORT=true
